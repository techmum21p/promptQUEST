# Google AI Studio Configuration (DEFAULT - Recommended for easier setup)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# Model Configuration
LLM_MODEL=gemini-1.5-flash

# Alternative: Vertex AI Configuration (requires Google Cloud setup)
# Only enable this if you want to use Vertex AI instead of Google AI Studio
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# LLM_MODEL=gemini-2.0-flash-exp

# Setup Instructions:
# 1. Copy this file to .env
# 2. Get your Google AI Studio API key from: https://aistudio.google.com/app/apikey
# 3. Replace 'your-api-key-here' with your actual API key
# 4. Save the file and run: streamlit run streamlit_app.py
#
# Note: The app defaults to Google AI Studio API key authentication.
# For Vertex AI, you need to authenticate using: gcloud auth application-default login