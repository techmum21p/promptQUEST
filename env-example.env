# Choose your authentication method:
# Option 1: Google AI Studio (Recommended for development/testing)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-api-key-here

# Option 2: Google Cloud Vertex AI (for production)
# Uncomment below and comment out Google AI Studio config above
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model Configuration
LLM_MODEL=gemini-2.0-flash-exp

# Notes:
# For Google AI Studio: Get API key from https://makersuite.google.com/app/apikey
# For Vertex AI: Set up authentication with: gcloud auth application-default login