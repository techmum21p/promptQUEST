# Google Cloud Vertex AI Configuration
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Alternative: Google AI Studio (for testing without Vertex AI)
# Uncomment below and comment out Vertex AI config above


# Model Configuration
LLM_MODEL=gemini-2.5-flash

# Note: For Vertex AI, you need to authenticate using:
# gcloud auth application-default login

# Large Language Model Configuration
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=AIzaSyCECeBLMKryqsGM0DbVR6wxTfa7W8znCKw
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=prompt_training_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Database Connection Pool Settings
POSTGRES_MIN_CONNECTIONS=5
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SSL_MODE=prefer
POSTGRES_COMMAND_TIMEOUT=30.0

# Application Settings
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Optional: LDAP Configuration (if integrating with LDAP)
LDAP_SERVER=ldap://ldap.company.com
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=company,dc=com
LDAP_BIND_PASSWORD=ldap_password_here
LDAP_USER_BASE=ou=users,dc=company,dc=com
LDAP_GROUP_BASE=ou=groups,dc=company,dc=com

# Optional: Redis Configuration (for session caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Settings
SECRET_KEY=your_secret_key_here_change_in_production
TOKEN_EXPIRY_HOURS=24
BCRYPT_ROUNDS=12

# Batch Processing Settings
BATCH_FLUSH_THRESHOLD=5
SESSION_TIMEOUT_SECONDS=7200

# Monitoring and Logging
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_FILE_PATH=/logs/prompt_training.log
ERROR_LOG_PATH=/logs/prompt_training_errors.log